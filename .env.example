# Copy to .env.local and fill in real values. Never commit real credentials.

# Neon pooled connection (host contains "-pooler"). Used by the app at runtime.
DATABASE_URL="postgresql://USER:PASSWORD@ep-example-pooler.REGION.aws.neon.tech/neondb?sslmode=require"

# Neon direct connection (no "-pooler"). Used only by the Prisma CLI for migrations.
DIRECT_URL="postgresql://USER:PASSWORD@ep-example.REGION.aws.neon.tech/neondb?sslmode=require"

# Admin login. Generate the hash with: npm run admin:hash -- "your password"
ADMIN_PASSWORD_HASH="scrypt:SALT_HEX:HASH_HEX"

# Random string of 32+ characters used to sign admin session cookies, e.g.
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET="replace-with-a-long-random-string"
